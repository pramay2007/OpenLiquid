# Copy to .env. Never commit .env.

# Arc testnet deployment
ARC_RPC_URL=https://rpc.testnet.arc.io
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

# Collateral. Leave unset to deploy a faucet test USDC; set to Arc's USDC to use the real
# testnet asset: 0x3600000000000000000000000000000000000000
USDC_ADDRESS=
SEED_LIQUIDITY=2000000

# Keeper
NETWORK=localhost
PORT=8787
